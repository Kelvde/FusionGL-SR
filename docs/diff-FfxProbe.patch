-        FfxVkFsr3_3_1_6FrameGenerationImage out{};
-        out.image = output; out.format = colorFormat;
-        out.width = displayWidth; out.height = displayHeight;
-        out.layout = VK_IMAGE_LAYOUT_GENERAL; out.usage = sampledStorage;
